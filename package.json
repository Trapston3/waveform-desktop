{
  "name": "waveform-desktop",
  "version": "1.3.4",
  "description": "WaveForm Windows Desktop Client",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "build": "tsc && vite build && node -e \"const fs = require('fs'), path = require('path'); fs.mkdirSync('dist/assets/data', { recursive: true }); for (const f of fs.readdirSync('src/assets/data')) { const s = path.join('src/assets/data', f); if (fs.statSync(s).isFile()) fs.copyFileSync(s, path.join('dist/assets/data', f)); }\" && npm run electron:compile",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit && tsc -p electron/tsconfig.preload.json --noEmit",
    "test": "node tests/runner.mjs",
    "electron:compile": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "electron:dev": "node scripts/dev.mjs",
    "electron:build": "npm run build",
    "build:rust": "cargo build --release --manifest-path native/waveform-core/Cargo.toml && node -e \"const fs=require('fs'); fs.copyFileSync('native/waveform-core/target/release/waveform_core.dll','native/waveform-core/waveform-core.win32-x64-msvc.node');\"",
    "test:rust": "cargo test --manifest-path native/waveform-core/Cargo.toml",
    "dist:win": "npm run build:rust && npm run build && electron-builder --win nsis portable --publish never && node scripts/generate-checksums.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/three": "^0.187.0",
    "clsx": "^2.1.1",
    "googlevideo": "^5.0.1",
    "lucide-react": "^1.16.0",
    "music-metadata": "^12.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "three": "^0.187.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "30.5.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
