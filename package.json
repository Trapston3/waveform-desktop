{
  "name": "waveform-desktop",
  "version": "1.0.0",
  "description": "WaveForm Windows Desktop Client",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.waveform.desktop",
    "productName": "WaveForm",
    "win": {
      "icon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "build": "tsc && vite build && node -e \"const fs = require('fs'); fs.mkdirSync('dist/assets/data', { recursive: true }); fs.copyFileSync('src/assets/data/auto_eq.db', 'dist/assets/data/auto_eq.db');\" && npm run electron:compile",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit && tsc -p electron/tsconfig.preload.json --noEmit",
    "test": "node tests/runner.mjs",
    "electron:compile": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "electron:dev": "node scripts/dev.mjs",
    "electron:build": "npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "music-metadata": "^12.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "30.5.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
